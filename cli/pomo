#!/usr/bin/env bash
# pomo v0.1 — minimal Pomodoro CLI, no deps (no jq).
# State: ${XDG_STATE_HOME:-~/.local/state}/omarchy-student-pomodoro/state.json
set -euo pipefail

FOCUS_LEN=1500  # 25m
BREAK_LEN=300   # 5m

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-student-pomodoro"
STATE_FILE="$STATE_DIR/state.json"

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
SOUND_FILE="$SCRIPT_DIR/../sounds/done.wav"
[ -f "$SOUND_FILE" ] || SOUND_FILE="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"

play_sound() {
  if command -v paplay >/dev/null 2>&1; then
    paplay "$SOUND_FILE" 2>/dev/null &
  elif command -v aplay >/dev/null 2>&1; then
    aplay -q "$SOUND_FILE" 2>/dev/null &
  fi
  disown 2>/dev/null || true
}

mkdir -p "$STATE_DIR"
LOG_FILE="$STATE_DIR/pomo.log"
DEADLINE_FILE="$STATE_DIR/deadlines.tsv"
TAB=$'\t'

# Runtime durations (secs). Loaded from state so a custom length chosen via
# `pomo start <phase> <minutes>` becomes the new default for that phase.
FOCUS_LEN=$(sed -n 's/.*"focus_len":\([0-9]*\).*/\1/p' "$STATE_FILE" 2>/dev/null | head -1 || true)
BREAK_LEN=$(sed -n 's/.*"break_len":\([0-9]*\).*/\1/p' "$STATE_FILE" 2>/dev/null | head -1 || true)
TOTAL=$(sed -n 's/.*"total":\([0-9]*\).*/\1/p' "$STATE_FILE" 2>/dev/null | head -1 || true)
FOCUS_LEN=${FOCUS_LEN:-1500}
BREAK_LEN=${BREAK_LEN:-300}
TOTAL=${TOTAL:-0}

now() { date +%s; }

fmt() { # $1=secs -> m:ss
  printf '%d:%02d' $(( $1 / 60 )) $(( $1 % 60 ))
}

report() { # $1=human message -> terminal + log file
  echo "pomo: $1"
  printf '%s %s\n' "$(date '+%F %T')" "$1" >> "$LOG_FILE"
}

# --- state io (we own the format, so sed is enough, no jq) ---
get() { # $1=key $2=default
  local key="$1" def="$2" v=""
  case "$key" in
    phase|status)
      v=$(sed -n "s/.*\"$key\":\"\([^\"]*\)\".*/\1/p" "$STATE_FILE" 2>/dev/null | head -1 || true)
      ;;
    auto)
      v=$(sed -n "s/.*\"$key\":\([a-z]*\).*/\1/p" "$STATE_FILE" 2>/dev/null | head -1 || true)
      ;;
    *)
      v=$(sed -n "s/.*\"$key\":\([0-9]*\).*/\1/p" "$STATE_FILE" 2>/dev/null | head -1 || true)
      ;;
  esac
  echo "${v:-$def}"
}

save() { # $1=phase $2=status $3=ends_at $4=remaining [$5=auto, keeps current when empty]
  local auto="${5:-$(get auto "false")}"
  printf '{"phase":"%s","status":"%s","ends_at":%d,"remaining":%d,"auto":%s,"focus_len":%d,"break_len":%d,"total":%d}\n' \
    "$1" "$2" "$3" "$4" "$auto" "$FOCUS_LEN" "$BREAK_LEN" "$TOTAL" > "$STATE_FILE"
}

ensure_state() {
  if [ ! -f "$STATE_FILE" ]; then
    save "idle" "idle" 0 0
  fi
}

live_remaining() { # echoes remaining secs (clamped >=0)
  local status ends_at remaining n
  status=$(get status "idle")
  ends_at=$(get ends_at "0")
  remaining=$(get remaining "0")
  n=$(now)
  if [ "$status" = "done" ]; then
    echo 0
  elif [ "$status" = "running" ]; then
    echo $(( ends_at - n > 0 ? ends_at - n : 0 ))
  else
    echo "$remaining"
  fi
}

is_expired_running() { # true (0) when a running phase has hit zero but not yet completed
  local status phase ends_at n
  status=$(get status "idle")
  phase=$(get phase "idle")
  ends_at=$(get ends_at "0")
  n=$(now)
  [ "$status" = "running" ] && [ "$phase" != "idle" ] && [ "$n" -ge "$ends_at" ]
}

cmd_start() { # [focus|break] [minutes], default focus + stored length
  local phase="${1:-focus}" mins="${2:-}" n len
  case "$phase" in
    focus|break) ;;
    *) echo "usage: pomo start [focus|break] [minutes]" >&2; exit 1 ;;
  esac
  if [ -n "$mins" ]; then
    case "$mins" in
      ''|*[!0-9]*|0) echo "minutes must be a positive number" >&2; exit 1 ;;
    esac
    len=$(( mins * 60 ))
    if [ "$phase" = "focus" ]; then FOCUS_LEN=$len; else BREAK_LEN=$len; fi
  elif [ "$phase" = "focus" ]; then
    len=$FOCUS_LEN
  else
    len=$BREAK_LEN
  fi
  TOTAL=$len
  n=$(now)
  if [ "$phase" = "focus" ]; then
    save "focus" "running" $(( n + len )) "$len"
    report "focus started · $(fmt "$len")"
  else
    save "break" "running" $(( n + len )) "$len"
    report "break started · $(fmt "$len")"
  fi
}

cmd_pause() {
  local status phase remaining n ends_at
  ensure_state
  status=$(get status "idle")
  if [ "$status" = "done" ]; then
    report "$(get phase "focus") finished — use toggle/skip to start next"
    exit 0
  fi
  if [ "$status" != "running" ]; then
    report "nothing to pause (status: $status)"
    exit 0
  fi
  if is_expired_running; then
    # Finished but not yet completed: log it once instead of pausing a 0:00 timer
    # (pausing here used to allow a resume+re-expiry that double-counted).
    cmd_expired
    exit 0
  fi
  phase=$(get phase "focus")
  ends_at=$(get ends_at "0")
  n=$(now)
  remaining=$(( ends_at - n > 0 ? ends_at - n : 0 ))
  save "$phase" "paused" "$ends_at" "$remaining"
  report "$phase paused · $(fmt "$remaining") left"
}

cmd_resume() {
  local status phase remaining n
  ensure_state
  status=$(get status "idle")
  if [ "$status" = "done" ]; then
    report "$(get phase "focus") finished — use toggle/skip to start next"
    exit 0
  fi
  if [ "$status" != "paused" ]; then
    report "nothing to resume (status: $status)"
    exit 0
  fi
  remaining=$(get remaining "0")
  if [ "$remaining" -le 0 ]; then
    # Legacy expired-paused state (paused at 0:00 before the done fix):
    # mark finished instead of resuming a timer that would instantly re-expire
    # and log a duplicate completion.
    phase=$(get phase "focus")
    save "$phase" "done" "$(get ends_at "0")" 0
    report "$phase finished — use toggle/skip to start next"
    exit 0
  fi
  phase=$(get phase "focus")
  n=$(now)
  save "$phase" "running" $(( n + remaining )) "$remaining"
  report "$phase resumed · $(fmt "$remaining") left"
}

cmd_toggle() {
  ensure_state
  local status
  status=$(get status "idle")
  if [ "$status" = "done" ]; then
    # Finished session acknowledged: start the next phase.
    case "$(get phase "idle")" in
      focus) cmd_start "break" ;;
      break) cmd_start "focus" ;;
      *)     cmd_start "focus" ;;
    esac
    return
  fi
  if [ "$status" = "paused" ] && [ "$(get remaining "0")" -le 0 ]; then
    # Legacy expired-paused state: same as done, start next (completion already logged).
    cmd_resume # converts to done + reports
    return
  fi
  if is_expired_running; then
    # Expired but completion not logged yet: log once, then start next
    # (unless auto-start already advanced us).
    cmd_expired
    if [ "$(get status "idle")" = "done" ]; then
      case "$(get phase "idle")" in
        focus) cmd_start "break" ;;
        break) cmd_start "focus" ;;
        *)     cmd_start "focus" ;;
      esac
    fi
    return
  fi
  case "$status" in
    running) cmd_pause ;;
    paused)  cmd_resume ;;
    *)       cmd_start "focus" ;;
  esac
}

cmd_reset() {
  TOTAL=0
  save "idle" "idle" 0 0
  report "reset to idle"
}

cmd_skip() {
  ensure_state
  if [ "$(get status "idle")" = "done" ]; then
    case "$(get phase "idle")" in
      focus) cmd_start "break" ;;
      break) cmd_start "focus" ;;
      *)     cmd_start "focus" ;;
    esac
    return
  fi
  if is_expired_running; then
    # Skipping a just-finished phase: make sure the completion is logged once.
    # cmd_expired auto-starts next when auto is on (then we're done);
    # otherwise it marks done and we advance below.
    cmd_expired
    if [ "$(get status "idle")" = "running" ]; then
      return
    fi
  fi
  case "$(get phase "idle")" in
    focus) cmd_start "break" ;;
    break) cmd_start "focus" ;;
    *)     cmd_start "focus" ;;
  esac
}

cmd_status() {
  ensure_state
  local phase status ends_at remaining n expired="false"
  phase=$(get phase "idle")
  status=$(get status "idle")
  ends_at=$(get ends_at "0")
  remaining=$(live_remaining)
  n=$(now)
  if [ "$status" = "done" ]; then
    expired="true"
  elif [ "$status" = "running" ] && [ "$n" -ge "$ends_at" ] && [ "$phase" != "idle" ]; then
    expired="true"
  fi
  printf '{"phase":"%s","status":"%s","ends_at":%d,"remaining":%d,"expired":%s,"auto":%s,"total":%d}\n' \
    "$phase" "$status" "$ends_at" "$remaining" "$expired" "$(get auto "false")" "$(get total "0")"
}

count_from() { # $1=start-date (YYYY-MM-DD) -> focus sessions completed since then
  if [ ! -f "$LOG_FILE" ]; then
    echo 0
    return
  fi
  awk -v s="$1" '$1 >= s && /focus completed/' "$LOG_FILE" | wc -l
}

cmd_stats() { # [day|week|month|--json], default day
  local scope="${1:-day}" today monday month_start d w m n
  today=$(date +%F)
  monday=$(date -d "$today - $(( $(date +%u) - 1 )) days" +%F)
  month_start=$(date +%Y-%m-01)
  d=$(count_from "$today")
  w=$(count_from "$monday")
  m=$(count_from "$month_start")
  if [ "$scope" = "--json" ]; then
    printf '{"day":%d,"week":%d,"month":%d}\n' "$d" "$w" "$m"
    return
  fi
  case "$scope" in
    day)   n=$d; scope="today" ;;
    week)  n=$w; scope="this week" ;;
    month) n=$m; scope="this month" ;;
    *) echo "usage: pomo stats [day|week|month|--json]" >&2; exit 1 ;;
  esac
  if [ "$n" -eq 1 ]; then
    echo "1 focus session $scope"
  else
    echo "$n focus sessions $scope"
  fi
}

cmd_bell() {
  ensure_state
  local phase msg
  phase=$(get phase "idle")
  case "$phase" in
    focus) msg="Focus done — break time" ;;
    break) msg="Break over — back to focus" ;;
    *)     msg="Pomodoro" ;;
  esac
  notify-send "Pomodoro" "$msg" 2>/dev/null || true
  play_sound
  report "bell: $msg"
}

cmd_autostart() { # [on|off|toggle], no arg prints current state
  ensure_state
  local cur="${1:-status}" auto next
  auto=$(get auto "false")
  case "$cur" in
    on)     next="true" ;;
    off)    next="false" ;;
    toggle) [ "$auto" = "true" ] && next="false" || next="true" ;;
    status) echo "auto-start $auto"; return ;;
    *) echo "usage: pomo autostart [on|off|toggle]" >&2; exit 1 ;;
  esac
  local phase status ends_at remaining
  phase=$(get phase "idle")
  status=$(get status "idle")
  ends_at=$(get ends_at "0")
  remaining=$(get remaining "0")
  save "$phase" "$status" "$ends_at" "$remaining" "$next"
  report "auto-start $next"
}

cmd_expired() {
  # Edge handler: call when a running phase may have hit zero.
  # Rings the bell for the finished phase once, persists a "done" state,
  # then auto-starts the next phase when auto-start is on.
  # Silent + idempotent unless something actually expired.
  ensure_state
  local phase status ends_at n auto msg next
  phase=$(get phase "idle")
  status=$(get status "idle")
  ends_at=$(get ends_at "0")
  n=$(now)
  if [ "$status" = "done" ]; then
    exit 0
  fi
  if [ "$status" != "running" ] || [ "$phase" = "idle" ] || [ "$n" -lt "$ends_at" ]; then
    exit 0
  fi
  if [ "$phase" = "focus" ]; then
    msg="Focus done — break time"
    next="break"
  else
    msg="Break over — back to focus"
    next="focus"
  fi
  if [ "$TOTAL" -le 0 ]; then
    if [ "$phase" = "focus" ]; then TOTAL=$FOCUS_LEN; else TOTAL=$BREAK_LEN; fi
  fi
  report "$phase completed · $(fmt "$TOTAL")"
  notify-send "Pomodoro" "$msg" 2>/dev/null || true
  play_sound
  auto=$(get auto "false")
  if [ "$auto" = "true" ]; then
    cmd_start "$next"
  else
    # Persist completion so a later pause/resume/toggle can't re-expire
    # the same finished timer and double-count it.
    save "$phase" "done" "$ends_at" 0
  fi
}

# --- deadlines (manual entry; "id<TAB>epoch<TAB>title" per line, no jq) ---
# Deadlines are typed by hand on purpose: university feeds are unreliable or
# missing, and the deadlines that matter most (read ch.7, draft by Sunday) never
# live in one anyway. Entry has to be forgiving, so `date -d` does the parsing.

parse_when() { # $1=free date text -> epoch
  local when="$1" ts norm
  # Forgiving input: strip the filler words people actually type ("in 3 hours",
  # "by friday", "due monday") and expand "3d"/"2w" shorthand, then let GNU
  # date do the real work.
  norm=$(printf '%s' "$when" | sed -E 's/^[[:space:]]*(in|by|on|at|due|until|till)[[:space:]]+//I; s/[[:space:]]+$//')
  case "$norm" in
    [0-9]*[hH]) norm="${norm%[hH]} hours" ;;
    [0-9]*[dD]) norm="${norm%[dD]} days" ;;
    [0-9]*[wW]) norm="${norm%[wW]} weeks" ;;
  esac
  ts=$(date -d "$norm" +%s 2>/dev/null) || return 1
  # A bare day ("friday", "tomorrow", "2026-09-12") parses to 00:00, which as a
  # deadline means the *start* of the day nobody intends. Land on its end
  # instead. Anything carrying a real time ("friday 17:00", "3 hours") is
  # already off midnight and passes through untouched.
  if [ "$(date -d "@$ts" +%H%M%S)" = "000000" ]; then
    ts=$(date -d "$(date -d "@$ts" +%F) 23:59" +%s)
  fi
  echo "$ts"
}

when_text() { # $1=epoch -> "Fri 12 Sep 23:59"
  date -d "@$1" '+%a %d %b %H:%M'
}

rel() { # $1=epoch -> "in 4d" / "in 3h" / "5m late"
  local d a unit
  d=$(( $1 - $(now) ))
  a=${d#-}
  if [ "$a" -ge 86400 ]; then unit="$(( a / 86400 ))d"
  elif [ "$a" -ge 3600 ]; then unit="$(( a / 3600 ))h"
  else unit="$(( a / 60 ))m"
  fi
  if [ "$d" -lt 0 ]; then echo "$unit late"; else echo "in $unit"; fi
}

next_id() {
  [ -s "$DEADLINE_FILE" ] || { echo 1; return; }
  awk -F'\t' '$1+0 > m { m = $1+0 } END { print m + 1 }' m=0 "$DEADLINE_FILE"
}

sorted_deadlines() {
  sort -t"$TAB" -k2,2n "$DEADLINE_FILE"
}

cmd_deadline_add() { # <title> <when...>
  local title="${1:-}" when ts id
  shift 2>/dev/null || true
  when="$*"
  if [ -z "$title" ] || [ -z "$when" ]; then
    echo 'usage: pomo deadline add <title> <when...>' >&2
    echo '  e.g. pomo deadline add "Essay draft" next friday 17:00' >&2
    exit 1
  fi
  if ! ts=$(parse_when "$when"); then
    echo "pomo: can't read a date out of \"$when\"" >&2
    exit 1
  fi
  title=${title//"$TAB"/ }
  id=$(next_id)
  printf '%d\t%d\t%s\n' "$id" "$ts" "$title" >> "$DEADLINE_FILE"
  report "deadline #$id · $(when_text "$ts") · $title"
}

cmd_deadline_list() { # [--json]
  if [ ! -s "$DEADLINE_FILE" ]; then
    if [ "${1:-}" = "--json" ]; then
      echo '{"deadlines":[]}'
    else
      echo 'no deadlines — pomo deadline add "Essay draft" friday'
    fi
    return
  fi
  if [ "${1:-}" = "--json" ]; then
    sorted_deadlines | awk -F'\t' '
      BEGIN { printf "{\"deadlines\":[" }
      {
        t = $3
        gsub(/\\/, "\\\\", t)
        gsub(/"/, "\\\"", t)
        printf "%s{\"id\":%d,\"due\":%d,\"title\":\"%s\"}", (NR > 1 ? "," : ""), $1, $2, t
      }
      END { print "]}" }'
    return
  fi
  local id ts title
  sorted_deadlines | while IFS="$TAB" read -r id ts title; do
    printf '%3s  %-17s %-9s %s\n' "$id" "$(when_text "$ts")" "$(rel "$ts")" "$title"
  done
}

cmd_deadline_rm() { # <id>
  local id="${1:-}" tmp
  case "$id" in
    ''|*[!0-9]*) echo "usage: pomo deadline rm <id>" >&2; exit 1 ;;
  esac
  if [ ! -s "$DEADLINE_FILE" ] || ! awk -F'\t' -v id="$id" '$1+0 == id+0 { f = 1 } END { exit !f }' "$DEADLINE_FILE"; then
    echo "pomo: no deadline #$id" >&2
    exit 1
  fi
  tmp=$(mktemp "$DEADLINE_FILE.XXXXXX")
  awk -F'\t' -v id="$id" '$1+0 != id+0' "$DEADLINE_FILE" > "$tmp"
  mv "$tmp" "$DEADLINE_FILE"
  report "deadline #$id removed"
}

cmd_deadline_next() { # [--json] -> soonest upcoming, else least-late overdue
  local line id ts title
  if [ -s "$DEADLINE_FILE" ]; then
    # First upcoming wins; when everything has passed, fall back to the last
    # (least late) one. The bar widget picks the same way.
    line=$(sorted_deadlines | awk -F'\t' -v n="$(now)" '
      $2+0 >= n { print; found = 1; exit }
      { last = $0 }
      END { if (!found && last != "") print last }')
  fi
  if [ -z "${line:-}" ]; then
    [ "${1:-}" = "--json" ] && echo '{"next":null}' || echo "no deadlines"
    return
  fi
  IFS="$TAB" read -r id ts title <<< "$line"
  if [ "${1:-}" = "--json" ]; then
    printf '{"next":{"id":%d,"due":%d,"title":"%s"}}\n' "$id" "$ts" \
      "$(printf '%s' "$title" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
  else
    printf '#%s  %s  %s  %s\n' "$id" "$(when_text "$ts")" "$(rel "$ts")" "$title"
  fi
}

cmd_deadline() {
  local sub="${1:-list}"
  shift 2>/dev/null || true
  case "$sub" in
    add)      cmd_deadline_add "$@" ;;
    list|ls)  cmd_deadline_list "${1:-}" ;;
    rm|remove) cmd_deadline_rm "${1:-}" ;;
    next)     cmd_deadline_next "${1:-}" ;;
    --json)   cmd_deadline_list --json ;;
    *) echo "usage: pomo deadline [add <title> <when...> | list [--json] | rm <id> | next [--json]]" >&2; exit 1 ;;
  esac
}

usage() {
  echo "usage: pomo start [focus|break] [minutes] | pause | resume | toggle | reset | skip | status | stats [day|week|month|--json] | bell | autostart [on|off|toggle] | expired" >&2
  echo "       pomo deadline [add <title> <when...> | list [--json] | rm <id> | next [--json]]" >&2
}

ensure_state
case "${1:-}" in
  start)  shift; cmd_start "${1:-focus}" "${2:-}" ;;
  pause)  cmd_pause ;;
  resume) cmd_resume ;;
  toggle) cmd_toggle ;;
  reset)  cmd_reset ;;
  skip)   cmd_skip ;;
  status) cmd_status ;;
  stats)  shift; cmd_stats "${1:-day}" ;;
  bell)   cmd_bell ;;
  autostart) shift; cmd_autostart "${1:-status}" ;;
  expired) cmd_expired ;;
  deadline|deadlines) shift; cmd_deadline "$@" ;;
  -h|--help|help|"") usage; exit 1 ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
